<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="16dp"
    app:cardBackgroundColor="@color/store_surface"
    app:cardCornerRadius="24dp"
    app:cardElevation="0dp"
    app:strokeColor="@color/store_outline"
    app:strokeWidth="1dp">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="20dp"
        android:orientation="vertical">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:baselineAligned="false"
            android:gravity="top">
            <FrameLayout
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:layout_marginEnd="14dp"
                android:background="@drawable/bg_app_icon"
                android:importantForAccessibility="noHideDescendants">
                <TextView
                    android:id="@+id/card_initial"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:textColor="@color/store_on_primary_container"
                    android:textSize="26sp"
                    android:fontFamily="sans-serif-medium" />
                <ImageView
                    android:id="@+id/card_icon"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:padding="4dp"
                    android:contentDescription="@null"
                    android:scaleType="fitCenter"
                    android:visibility="gone" />
            </FrameLayout>
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView
                    android:id="@+id/card_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/store_text"
                    android:textSize="20sp"
                    android:fontFamily="sans-serif-medium" />
                <TextView
                    android:id="@+id/card_version"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textColor="@color/store_text_secondary"
                    android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>
        <TextView
            android:id="@+id/card_description"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:textColor="@color/store_text_secondary"
            android:textSize="14sp"
            android:lineSpacingExtra="3dp" />
        <TextView
            android:id="@+id/card_state"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_status_badge"
            android:paddingHorizontal="12dp"
            android:paddingVertical="6dp"
            android:textSize="12sp"
            android:fontFamily="sans-serif-medium" />
        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/card_download_progress"
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:layout_marginTop="20dp"
            android:visibility="gone"
            app:indicatorColor="@color/store_primary"
            app:trackColor="@color/store_surface_variant" />
        <TextView
            android:id="@+id/card_download_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:accessibilityLiveRegion="polite"
            android:textColor="@color/store_text_secondary"
            android:textSize="13sp"
            android:visibility="gone" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">
            <com.google.android.material.button.MaterialButton
                android:id="@+id/card_install_button"
                style="@style/Widget.Material3.Button"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:minHeight="48dp"
                android:text="@string/install_app"
                app:cornerRadius="16dp" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/card_cancel_download"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:minHeight="48dp"
                android:text="@android:string/cancel"
                android:visibility="gone" />
        </LinearLayout>
        <com.google.android.material.button.MaterialButton
            android:id="@+id/card_details_button"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:minHeight="48dp"
            android:gravity="start|center_vertical"
            android:paddingStart="0dp"
            android:paddingEnd="0dp"
            android:text="@string/release_details"
            android:textAlignment="viewStart"
            app:icon="@drawable/ic_expand_more"
            app:iconSize="20dp"
            app:iconGravity="end" />
        <LinearLayout
            android:id="@+id/card_details"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="16dp"
                android:background="@color/store_outline" />
            <TextView
                android:id="@+id/card_build"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/store_text"
                android:textSize="14sp" />
            <TextView
                android:id="@+id/card_installed"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textColor="@color/store_text_secondary"
                android:textSize="13sp" />
            <TextView
                android:id="@+id/card_requirement"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textColor="@color/store_text_secondary"
                android:textSize="13sp" />
            <TextView
                android:id="@+id/card_notes_heading"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/whats_new"
                android:textColor="@color/store_text"
                android:textSize="14sp"
                android:fontFamily="sans-serif-medium" />
            <TextView
                android:id="@+id/card_notes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="@color/store_text_secondary"
                android:textSize="14sp"
                android:lineSpacingExtra="4dp" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
